# Скопіювати в .env і вставити ключі. .env у git не потрапляє.

# ОБОВ'ЯЗКОВО — сценарій (Claude, structured output)
ANTHROPIC_API_KEY=

# ОБОВ'ЯЗКОВО для дефолтного шляху — кадр-ключ (Flux / Nano Banana) і відео (Kling) через fal.ai
FAL_KEY=

# ОБОВ'ЯЗКОВО для дефолтного шляху — голос (ElevenLabs v3)
ELEVENLABS_API_KEY=

# ОПЦІЙНО — Veo 3.1 (альтернативний відео-провайдер і режим `native` для евалу)
GOOGLE_API_KEY=

# Стеля вартості одного прогону, USD. Перевищення → стоп із повідомленням.
MAX_RUN_COST_USD=3

# fake | real — fake ганяє весь пайплайн без мережі й грошей
PIPELINE_PROVIDERS=real

# tts+mux (дефолт) | native | tts+avatar
AUDIO_MODE=tts+mux

# Розмір моделі faster-whisper для воріт дослівності
WHISPER_MODEL=small.en
