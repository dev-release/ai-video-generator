# --- Required for real mode -------------------------------------------------------------------
# Script (Claude, structured output)
ANTHROPIC_API_KEY=
# Video (Kling), lipsync and speech recognition (whisper), all via fal.ai
FAL_KEY=

# --- Spending caps, USD -------------------------------------------------------------------------
# A run stops BEFORE a paid call that would exceed a cap. Upper bounds: 5 per run, 20 per day.
MAX_RUN_COST_USD=2
MAX_DAILY_COST_USD=5

# --- Mode --------------------------------------------------------------------------------------
# real: paid APIs; fake: the whole pipeline offline for $0 (drawn character, no keys needed)
PIPELINE_PROVIDERS=real
# Voice in fake mode: tone = murmur without words, no models; kokoro = real speech
# (needs `make install-local`, the same voice real mode uses)
FAKE_VOICE=kokoro

# --- Models (entry names in src/pipeline/models.yaml) -------------------------------------------
SCRIPT_MODEL=claude-sonnet-5-5      # claude-sonnet-5-5 | claude-opus-5-5
TTS_MODEL=kokoro                    # local, $0 (make install-local)
VIDEO_MODEL=kling-v3-std            # kling-v3-std | kling-v3-pro
LIPSYNC_MODEL=kling-lipsync         # kling-lipsync ($0.014/s, up to ~12 min, 2–10 s clips) | sync-lipsync-v2 ($0.05/s, fast)
ASR_MODEL=fal-whisper
FACE_MODEL=yunet

# Lip sync check: warn = shown in the report/UI; block = the run fails (after calibrating thresholds)
SYNC_GATE=warn

# --- Pacing, seconds (the values used are saved to runs/<id>/pacing.json) ----------------------
# A shot = PACE_LEAD_S + the line (with pauses between phrases) + PACE_TAIL_S
PACE_LEAD_S=0.3
PACE_TAIL_S=0.3
PACE_MIN_SHOT_S=2.0
PACE_MIN_FINAL_S=0         # 8 pads the video to 8 s with a freeze frame
PAUSE_SENTENCE_S=0.6       # after . ! ? (when text follows)
PAUSE_ELLIPSIS_S=1.0       # after ...
PAUSE_DASH_S=0.5           # at " — "
PAUSE_COLON_S=0.4          # after ; :
