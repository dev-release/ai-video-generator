#!/usr/bin/env bash
# Git pre-commit gate: broken code is not committed. Enabled by: git config core.hooksPath .claude/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() { echo "✗ pre-commit: $1" >&2; exit 1; }

# 1. Secrets: .env and key-like strings never reach git
staged=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$staged" | grep -xE '\.env|\.env\.local' >/dev/null; then fail ".env is staged"; fi
if git diff --cached -U0 --diff-filter=ACM -- . ':(exclude).env.example' ':(exclude).claude/hooks/pre-commit' \
   | grep -E '^\+' | grep -E '(sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|sk_[a-f0-9]{40,}|AIza[0-9A-Za-z_-]{35}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9a-f]{32}|(FAL_KEY|ANTHROPIC_API_KEY)=[^[:space:]]{10,})' >/dev/null; then
  fail "the diff contains what looks like an API key"
fi

# 2. Lint
uv run --quiet ruff check . || fail "ruff check"
uv run --quiet ruff format --check . || fail "ruff format --check (run make fmt)"

# 3. Tests (fake backend, no network, no money)
uv run --quiet pytest -q -x || fail "pytest"

# 4. API <-> UI contract: TS types are generated from OpenAPI; backend changed -> make ui-types
if echo "$staged" | grep -E '^src/pipeline/(api|schema)\.py$' >/dev/null; then
  uv run --quiet python -c "import json; from pipeline.api import build_app; print(json.dumps(build_app().openapi()))" \
    | cmp -s - ui/openapi.json || fail "OpenAPI changed but ui/openapi.json did not: make ui-types"
fi

# 5. Frontend: strict typecheck + lint when ui/ changed
if echo "$staged" | grep -E '^ui/' >/dev/null; then
  [ -d ui/node_modules ] || fail "ui/node_modules missing — cd ui && npm ci"
  (cd ui && npx tsc -b --noEmit) || fail "tsc (ui)"
  (cd ui && npx oxlint --deny-warnings src) || fail "oxlint (ui)"
fi

echo "✓ pre-commit: ok"
