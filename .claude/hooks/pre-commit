#!/usr/bin/env bash
# Git pre-commit — ворота на коміт (CONTEXT.md §9). Зламане не комітиться.
# Підключено через: git config core.hooksPath .claude/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() { echo "✗ pre-commit: $1" >&2; exit 1; }

# 1. Ключі: .env і схожі на секрети рядки не потрапляють у git
staged=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$staged" | grep -xE '\.env|\.env\.local' >/dev/null; then fail ".env у staged"; fi
if git diff --cached -U0 --diff-filter=ACM -- . ':(exclude).env.example' ':(exclude).claude/hooks/pre-commit' \
   | grep -E '^\+' | grep -E '(sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|AIza[0-9A-Za-z_-]{35}|FAL_KEY=[^[:space:]]{10,})' >/dev/null; then
  fail "у diff схоже на API-ключ"
fi

# 2. Лінт
uv run --quiet ruff check . || fail "ruff check"
uv run --quiet ruff format --check . || fail "ruff format --check (запусти make fmt)"

# 3. Тести (fake-бекенд, без мережі й грошей)
uv run --quiet pytest -q -x || fail "pytest"

echo "✓ pre-commit: ok"
